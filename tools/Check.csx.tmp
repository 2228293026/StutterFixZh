using System;
using System.Collections.Generic;
using System.IO;
using System.Linq;
using System.Text;
using System.Text.RegularExpressions;

// 提取 SettingsWindow.cs 中所有 T("ko","en") 调用的英文文本，
// 与 zh-CN.json 的键对比，输出缺失/失配的键。
class Check
{
    static void Main()
    {
        var src = File.ReadAllText(@"d:\Projects\StutterFix\SettingsWindow.cs", Encoding.UTF8);
        var jsonText = File.ReadAllText(@"d:\Projects\StutterFix\StutterFixZh\zh-CN.json", Encoding.UTF8);
        var json = Newtonsoft.Json.JsonConvert.DeserializeObject<Dictionary<string, string>>(jsonText);

        // 反归一化：把 JSON 键折叠空白，便于匹配含换行的源码文本
        static string Norm(string s) => string.Join(" ", s.Split((char[])null, StringSplitOptions.RemoveEmptyEntries));
        var normKeys = new HashSet<string>(json.Keys.Select(Norm));

        // 简单 T("ko","en") 调用
        var rx = new Regex(@"T\(\s*""((?:[^""\\]|\\.)*)""\s*,\s*""((?:[^""\\]|\\.)*)""\s*\)");
        var missing = new SortedSet<string>(StringComparer.Ordinal);
        foreach (Match m in rx.Matches(src))
        {
            var en = Unescape(m.Groups[2].Value);
            if (!json.ContainsKey(en) && !normKeys.Contains(Norm(en)))
                missing.Add(en);
        }

        // 拼接调用 T("ko" + x, "en" + y) —— 提取字符串字面量片段做片段检查
        var rxConcat = new Regex(@"T\(\s*""((?:[^""\\]|\\.)*)""\s*\+.*?,\s*""((?:[^""\\]|\\.)*)""\s*\+.*?\)", RegexOptions.Singleline);
        var concatPieces = new SortedSet<string>(StringComparer.Ordinal);
        foreach (Match m in rxConcat.Matches(src))
        {
            var enFirst = Unescape(m.Groups[2].Value);
            if (!string.IsNullOrWhiteSpace(enFirst))
                concatPieces.Add(enFirst);
        }

        Console.WriteLine("=== 缺失的完整键 (" + missing.Count + ") ===");
        foreach (var k in missing) Console.WriteLine(Show(k));
        Console.WriteLine();
        Console.WriteLine("=== 拼接调用的英文首片段（需模板匹配，检查是否已覆盖） ===");
        foreach (var k in concatPieces) Console.WriteLine(Show(k));
    }

    static string Unescape(string s) =>
        s.Replace("\\\"", "\"").Replace("\\n", "\n").Replace("\\\\", "\\");

    static string Show(string s)
    {
        var oneLine = s.Replace("\n", "\\n");
        return oneLine.Length > 160 ? oneLine.Substring(0, 160) + "..." : oneLine;
    }
}
